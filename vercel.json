{
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run build -w server && mkdir -p public && touch public/.placeholder",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 300,
      "includeFiles": "{server/dist/**,server/node_modules/**,shared/**,node_modules/better-sqlite3/**,node_modules/bindings/**,node_modules/file-uri-to-path/**,node_modules/@freellmapi/**}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.mjs"
    }
  ]
}
