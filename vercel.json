{
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run build -w server && npm run build -w client && rm -rf public && mkdir -p public && cp -r client/dist/. public/ && cp vercel/status.html public/status.html",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 300,
      "includeFiles": "{server/dist/**,vercel/**,server/node_modules/**,shared/**,node_modules/better-sqlite3/**,node_modules/bindings/**,node_modules/file-uri-to-path/**,node_modules/@freellmapi/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.mjs"
    },
    {
      "source": "/v1/(.*)",
      "destination": "/api/index.mjs"
    },
    {
      "source": "/v1beta/(.*)",
      "destination": "/api/index.mjs"
    },
    {
      "source": "/((?!api/|v1/|v1beta/).*)",
      "destination": "/index.html"
    }
  ]
}
